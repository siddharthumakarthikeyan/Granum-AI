{
  "name": "granum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Granum dashboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/stamp-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run src",
    "test:e2e": "npm run typecheck:e2e && npm run build && playwright test"
  },
  "dependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/react": "~9.4.0",
    "@deck.gl/widgets": "~9.4.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "apache-arrow": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
